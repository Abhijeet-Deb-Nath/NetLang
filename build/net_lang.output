Grammar

    0 $accept: program $end

    1 program: network_def
    2        | module_list network_def

    3 module_list: module_def
    4            | module_list module_def

    5 network_def: NETWORK IDENTIFIER LBRACE network_body RBRACE

    6 network_body: input_decl optional_weights_decl statement_list_nonempty

    7 module_def: MODULE IDENTIFIER LPAREN module_params RPAREN LBRACE statement_list return_stmt RBRACE

    8 module_params: %empty
    9              | param_list

   10 param_list: IDENTIFIER
   11           | param_list COMMA IDENTIFIER

   12 input_decl: INPUT LPAREN SHAPE COLON array RPAREN

   13 weights_decl: WEIGHTS LPAREN STRING_LIT RPAREN

   14 optional_weights_decl: %empty
   15                      | weights_decl

   16 statement_list: %empty
   17               | statement_list statement

   18 statement_list_nonempty: statement
   19                        | statement_list_nonempty statement

   20 statement: assignment

   21 assignment: IDENTIFIER ASSIGN layer_expr optional_from_clause

   22 optional_from_clause: %empty
   23                     | FROM expr

   24 return_stmt: RETURN expr

   25 layer_expr: conv2d_layer
   26           | dense_layer
   27           | pool_layer
   28           | flatten_layer
   29           | add_layer
   30           | concat_layer
   31           | norm_layer
   32           | module_call

   33 conv2d_layer: CONV2D LPAREN FILTERS COLON expr COMMA KERNEL COLON array COMMA STRIDE COLON expr COMMA PADDING COLON expr COMMA ACTIVATION COLON activation_value RPAREN

   34 dense_layer: DENSE LPAREN UNITS COLON expr COMMA ACTIVATION COLON activation_value RPAREN

   35 pool_layer: MAXPOOL LPAREN POOL COLON array COMMA STRIDE COLON expr COMMA PADDING COLON expr RPAREN
   36           | AVGPOOL LPAREN POOL COLON array COMMA STRIDE COLON expr COMMA PADDING COLON expr RPAREN

   37 flatten_layer: FLATTEN LPAREN RPAREN

   38 add_layer: ADD LPAREN add_args RPAREN

   39 add_args: expr
   40         | add_args COMMA expr

   41 concat_layer: CONCAT LPAREN concat_args RPAREN

   42 concat_args: expr
   43            | concat_args COMMA expr

   44 norm_layer: BATCHNORM LPAREN RPAREN
   45           | LAYERNORM LPAREN RPAREN

   46 module_call: IDENTIFIER LPAREN layer_params RPAREN

   47 layer_params: %empty
   48             | layer_param_list

   49 layer_param_list: IDENTIFIER COLON expr
   50                 | FILTERS COLON expr
   51                 | KERNEL COLON expr
   52                 | ACTIVATION COLON expr
   53                 | STRIDE COLON expr
   54                 | PADDING COLON expr
   55                 | POOL COLON expr
   56                 | UNITS COLON expr
   57                 | layer_param_list COMMA IDENTIFIER COLON expr
   58                 | layer_param_list COMMA FILTERS COLON expr
   59                 | layer_param_list COMMA KERNEL COLON expr
   60                 | layer_param_list COMMA ACTIVATION COLON expr
   61                 | layer_param_list COMMA STRIDE COLON expr
   62                 | layer_param_list COMMA PADDING COLON expr
   63                 | layer_param_list COMMA POOL COLON expr
   64                 | layer_param_list COMMA UNITS COLON expr

   65 expr: number
   66     | array
   67     | identifier_expr
   68     | activation_value

   69 identifier_expr: IDENTIFIER
   70                | INPUT

   71 number: NUMBER
   72       | FLOAT_NUM

   73 array: LBRACKET array_elements RBRACKET

   74 array_elements: number
   75               | array_elements COMMA number

   76 activation_value: RELU
   77                 | SIGMOID
   78                 | TANH
   79                 | SOFTMAX
   80                 | LINEAR


