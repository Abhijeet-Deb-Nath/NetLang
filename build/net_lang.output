Grammar

    0 $accept: program $end

    1 program: network_def
    2        | module_list network_def

    3 module_list: module_def
    4            | module_list module_def

    5 network_def: NETWORK IDENTIFIER LBRACE network_body RBRACE

    6 network_body: input_decl weights_decl statement_list_nonempty

    7 module_def: MODULE IDENTIFIER LPAREN module_params RPAREN LBRACE statement_list return_stmt RBRACE

    8 module_params: ε
    9              | param_list

   10 param_list: IDENTIFIER
   11           | param_list COMMA IDENTIFIER

   12 input_decl: INPUT LPAREN SHAPE COLON array RPAREN

   13 weights_decl: WEIGHTS LPAREN STRING_LIT RPAREN

   14 statement_list: ε
   15               | statement_list statement

   16 statement_list_nonempty: statement
   17                        | statement_list_nonempty statement

   18 statement: assignment

   19 assignment: IDENTIFIER ASSIGN layer_expr from_clause

   20 from_clause: FROM expr

   21 return_stmt: RETURN expr

   22 layer_expr: conv2d_layer
   23           | dense_layer
   24           | pool_layer
   25           | flatten_layer
   26           | concat_layer
   27           | norm_layer
   28           | module_call

   29 conv2d_layer: CONV2D LPAREN FILTERS COLON expr COMMA KERNEL COLON array COMMA STRIDE COLON expr COMMA PADDING COLON expr COMMA ACTIVATION COLON activation_value RPAREN

   30 dense_layer: DENSE LPAREN UNITS COLON expr COMMA ACTIVATION COLON activation_value RPAREN

   31 pool_layer: MAXPOOL LPAREN POOL COLON array COMMA STRIDE COLON expr COMMA PADDING COLON expr RPAREN
   32           | AVGPOOL LPAREN POOL COLON array COMMA STRIDE COLON expr COMMA PADDING COLON expr RPAREN

   33 flatten_layer: FLATTEN LPAREN RPAREN

   34 concat_layer: CONCAT LPAREN concat_args RPAREN

   35 concat_args: expr
   36            | concat_args COMMA expr

   37 norm_layer: BATCHNORM LPAREN RPAREN
   38           | LAYERNORM LPAREN RPAREN

   39 module_call: IDENTIFIER LPAREN layer_params RPAREN

   40 layer_params: ε
   41             | layer_param_list

   42 layer_param_list: IDENTIFIER COLON expr
   43                 | FILTERS COLON expr
   44                 | KERNEL COLON expr
   45                 | ACTIVATION COLON expr
   46                 | STRIDE COLON expr
   47                 | PADDING COLON expr
   48                 | POOL COLON expr
   49                 | UNITS COLON expr
   50                 | layer_param_list COMMA IDENTIFIER COLON expr
   51                 | layer_param_list COMMA FILTERS COLON expr
   52                 | layer_param_list COMMA KERNEL COLON expr
   53                 | layer_param_list COMMA ACTIVATION COLON expr
   54                 | layer_param_list COMMA STRIDE COLON expr
   55                 | layer_param_list COMMA PADDING COLON expr
   56                 | layer_param_list COMMA POOL COLON expr
   57                 | layer_param_list COMMA UNITS COLON expr

   58 expr: number
   59     | array
   60     | identifier_expr
   61     | activation_value

   62 identifier_expr: IDENTIFIER
   63                | INPUT

   64 number: NUMBER
   65       | FLOAT_NUM

   66 array: LBRACKET array_elements RBRACKET

   67 array_elements: number
   68               | array_elements COMMA number

   69 activation_value: RELU
   70                 | SIGMOID
   71                 | TANH
   72                 | SOFTMAX
   73                 | LINEAR


