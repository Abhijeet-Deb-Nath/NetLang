Grammar

    0 $accept: program $end

    1 program: definition_list

    2 definition_list: definition
    3                | definition_list definition

    4 definition: network_def
    5           | module_def

    6 network_def: NETWORK IDENTIFIER LBRACE network_body RBRACE

    7 network_body: ε
    8             | network_body input_decl
    9             | network_body weights_decl
   10             | network_body statement

   11 module_def: MODULE IDENTIFIER LPAREN module_params RPAREN LBRACE statement_list return_stmt RBRACE

   12 module_params: ε
   13              | param_list

   14 param_list: IDENTIFIER
   15           | param_list COMMA IDENTIFIER

   16 input_decl: INPUT LPAREN SHAPE COLON array RPAREN

   17 weights_decl: WEIGHTS LPAREN STRING_LIT RPAREN

   18 statement_list: ε
   19               | statement_list statement

   20 statement: assignment

   21 assignment: IDENTIFIER ASSIGN layer_expr from_clause

   22 from_clause: FROM expr

   23 return_stmt: RETURN expr
   24            | RETURN concat_layer

   25 layer_expr: conv2d_layer
   26           | dense_layer
   27           | pool_layer
   28           | flatten_layer
   29           | concat_layer
   30           | norm_layer
   31           | module_call

   32 conv2d_layer: CONV2D LPAREN layer_params RPAREN

   33 dense_layer: DENSE LPAREN layer_params RPAREN

   34 pool_layer: MAXPOOL LPAREN layer_params RPAREN
   35           | AVGPOOL LPAREN layer_params RPAREN

   36 flatten_layer: FLATTEN LPAREN RPAREN

   37 concat_layer: CONCAT LPAREN concat_args RPAREN

   38 concat_args: expr
   39            | concat_args COMMA expr

   40 norm_layer: BATCHNORM LPAREN RPAREN
   41           | LAYERNORM LPAREN RPAREN

   42 module_call: IDENTIFIER LPAREN layer_params RPAREN

   43 layer_params: ε
   44             | layer_param_list

   45 layer_param_list: IDENTIFIER COLON expr
   46                 | FILTERS COLON expr
   47                 | KERNEL COLON expr
   48                 | ACTIVATION COLON expr
   49                 | STRIDE COLON expr
   50                 | PADDING COLON expr
   51                 | POOL COLON expr
   52                 | UNITS COLON expr
   53                 | layer_param_list COMMA IDENTIFIER COLON expr
   54                 | layer_param_list COMMA FILTERS COLON expr
   55                 | layer_param_list COMMA KERNEL COLON expr
   56                 | layer_param_list COMMA ACTIVATION COLON expr
   57                 | layer_param_list COMMA STRIDE COLON expr
   58                 | layer_param_list COMMA PADDING COLON expr
   59                 | layer_param_list COMMA POOL COLON expr
   60                 | layer_param_list COMMA UNITS COLON expr

   61 expr: number
   62     | array
   63     | identifier_expr
   64     | activation_value

   65 identifier_expr: IDENTIFIER
   66                | INPUT

   67 number: NUMBER
   68       | FLOAT_NUM

   69 array: LBRACKET array_elements RBRACKET

   70 array_elements: number
   71               | array_elements COMMA number

   72 activation_value: RELU
   73                 | SIGMOID
   74                 | TANH
   75                 | SOFTMAX
   76                 | LINEAR


