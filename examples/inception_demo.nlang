// 1. DEFINITION PHASE
// Define the blueprint. 'input' is a special keyword referring to the incoming tensor.
module InceptionBlock(filters_1x1, filters_3x3, filters_5x5) {
    
    // Branch 1: Simple 1x1 Conv
    // We start from 'input' (implicit or explicit)
    b1 = Conv2D(filters: filters_1x1, kernel: [1,1], activation: relu) from input

    // Branch 2: 1x1 -> 3x3
    // Note: We chain them locally
    t2 = Conv2D(filters: filters_3x3, kernel: [1,1], activation: relu) from input
    b2 = Conv2D(filters: filters_3x3, kernel: [3,3], padding: 1, activation: relu) from t2

    // Branch 3: MaxPool -> 1x1
    t3 = MaxPool(pool: [3,3], stride: 1, padding: 1) from input
    b3 = Conv2D(filters: filters_1x1, kernel: [1,1], activation: relu) from t3

    // Merge: The result of the module
    return Concat(b1, b2, b3)
}

// 2. USAGE PHASE
network GoogleNet {
    input(shape: [224, 224, 3])
    
    // Standard layers
    x = Conv2D(filters: 64, kernel: [7,7], stride: 2) from input
    x = MaxPool(pool: [3,3], stride: 2) from x

    // INSTANTIATE THE REPEATABLE BLOCKS
    // The compiler expands these into the graph
    x = InceptionBlock(filters_1x1: 64, filters_3x3: 128, filters_5x5: 32) from x
    x = InceptionBlock(filters_1x1: 128, filters_3x3: 192, filters_5x5: 96) from x
    
    x = Dense(units: 1000) from x
}
