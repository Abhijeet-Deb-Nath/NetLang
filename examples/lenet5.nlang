// LeNet-5 Architecture for MNIST Dataset
// Weights: Converted from lenet_mnist.onnx
// Dataset: MNIST (28x28 handwritten digits)
// Classes: 10 (digits 0-9)
// Input: 28×28 grayscale images
// Architecture: Conv(32)→Pool→Conv(32)→Pool→Dense(100)→Dense(100)→Dense(10)
//
// ONNX Weight Shapes:
//   0.weight: [32, 1, 5, 5]  - Conv1: 32 filters
//   3.weight: [32, 32, 5, 5] - Conv2: 32 filters
//   7.weight: [100, 512]     - Dense1: 512→100
//   9.weight: [100, 100]     - Dense2: 100→100
//   11.weight: [10, 100]     - Dense3: 100→10

network LeNet5 {
    input(shape: [28, 28, 1])
    weights("assets/weights/netlang/lenet5_trained.nwf")
    
    // First convolutional layer: 28×28×1 → 24×24×32
    // 32 filters, 5×5 kernel, stride 1, no padding
    x = Conv2D(filters: 32, kernel: [5, 5], stride: 1, padding: 0, activation: relu) from input
    
    // First pooling layer: 24×24×32 → 12×12×32
    // 2×2 max pooling, stride 2
    x = MaxPool(pool: [2, 2], stride: 2, padding: 0) from x
    
    // Second convolutional layer: 12×12×32 → 8×8×32
    // 32 filters, 5×5 kernel, stride 1, no padding
    x = Conv2D(filters: 32, kernel: [5, 5], stride: 1, padding: 0, activation: relu) from x
    
    // Second pooling layer: 8×8×32 → 4×4×32
    // 2×2 max pooling, stride 2
    x = MaxPool(pool: [2, 2], stride: 2, padding: 0) from x
    
    // Flatten: 4×4×32 = 512 neurons
    x = Flatten() from x
    
    // First fully connected layer: 512 → 100
    x = Dense(units: 100, activation: relu) from x
    
    // Second fully connected layer: 100 → 100
    x = Dense(units: 100, activation: relu) from x
    
    // Output layer: 100 → 10 (softmax for classification)
    x = Dense(units: 10, activation: softmax) from x
}
