// GoogLeNet-Mini: Simplified Inception-style architecture
// Note: Full Inception modules require Concat which isn't fully implemented
// This is a simplified sequential version for testing

network GoogLeNet_Mini {
    input(shape: [224, 224, 3])
    weights("models/googlenet_mini.nwf")
    
    // Initial convolutions (stem)
    x = Conv2D(filters: 64, kernel: [7, 7], stride: 2, padding: 3, activation: relu) from input
    x = MaxPool(pool: [3, 3], stride: 2, padding: 1) from x
    
    x = Conv2D(filters: 64, kernel: [1, 1], stride: 1, padding: 0, activation: relu) from x
    x = Conv2D(filters: 192, kernel: [3, 3], stride: 1, padding: 1, activation: relu) from x
    x = MaxPool(pool: [3, 3], stride: 2, padding: 1) from x
    
    // Simplified inception-style blocks (sequential approximation)
    // Block 1
    x = Conv2D(filters: 64, kernel: [1, 1], stride: 1, padding: 0, activation: relu) from x
    x = Conv2D(filters: 128, kernel: [3, 3], stride: 1, padding: 1, activation: relu) from x
    
    // Block 2
    x = Conv2D(filters: 128, kernel: [1, 1], stride: 1, padding: 0, activation: relu) from x
    x = Conv2D(filters: 192, kernel: [3, 3], stride: 1, padding: 1, activation: relu) from x
    
    // Global average pooling (simulated)
    x = AvgPool(pool: [7, 7], stride: 1, padding: 0) from x
    
    // Classifier
    x = Flatten() from x
    x = Dense(units: 1000, activation: softmax) from x
}
