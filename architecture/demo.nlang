// NetLang Example Demonstrations
// ================================
// This file has been split into separate examples.
// Each .nlang file should contain exactly ONE network definition.
//
// Available examples:
//   - mnist.nlang       : Simple CNN for digit classification
//   - vgg16.nlang       : Deep VGG-style architecture
//   - inception.nlang   : Modular design with InceptionBlock
//   - test_valid.nlang  : Valid syntax for testing parser
//   - test_errors.nlang : Error cases for semantic analysis
//
// Usage:
//   ./net_lang examples/mnist.nlang

// Simple CNN for MNIST digit classification (0-9)
// Architecture: Conv-Pool-Conv-Pool-Dense-Dense
network MNIST_CNN {
    input(shape: [28, 28, 1])
    weights("models/mnist_cnn.nwf")
    
    x = Conv2D(filters: 32, kernel: [3, 3], stride: 1, padding: 1, activation: relu) from input
    x = MaxPool(pool: [2, 2]) from x
    x = Conv2D(filters: 64, kernel: [3, 3], stride: 1, padding: 1, activation: relu) from x
    x = MaxPool(pool: [2, 2]) from x
    x = Flatten() from x
    x = Dense(units: 128, activation: relu) from x
    x = Dense(units: 10, activation: softmax) from x
}
