%{
/*
 * NetLang Lexer - Phase 2 (Parser Integration)
 * Tokenizes NetLang DSL and returns tokens to Bison parser
 * 
 * Author: Abhijeet Deb Nath
 * Course: Compiler Design
 */

#include <stdio.h>
#include <string.h>
#include <stdlib.h>
#include "../ast/ast.h"  /* ADD THIS LINE */
#include "net_lang.tab.h"  /* Generated by Bison */

/* Track line numbers for error reporting */
int yycolumn = 1;

/* Update location tracking */
#define YY_USER_ACTION \
    yylloc.first_line = yylloc.last_line = yylineno; \
    yylloc.first_column = yycolumn; \
    yylloc.last_column = yycolumn + yyleng - 1; \
    yycolumn += yyleng;

%}

%option noyywrap
%option yylineno

/* Start conditions for multi-line comments */
%x COMMENT

/* Regular expressions for patterns */
DIGIT       [0-9]
INTEGER     {DIGIT}+
FLOAT       {DIGIT}+"."{DIGIT}*
ID          [a-zA-Z_][a-zA-Z0-9_]*
STRING      \"[^\"]*\"
WS          [ \t\r]
NEWLINE     \n
SLCOMMENT   "//"[^\n]*

%%

 /* ========== KEYWORDS ========== */
"network"     { return NETWORK; }
"module"      { return MODULE; }
"return"      { return RETURN; }
"from"        { return FROM; }
"input"       { return INPUT; }
"shape"       { return SHAPE; }
"weights"     { return WEIGHTS; }

 /* ========== LAYER TYPES ========== */
"Conv2D"      { return CONV2D; }
"Dense"       { return DENSE; }
"MaxPool"     { return MAXPOOL; }
"AvgPool"     { return AVGPOOL; }
"Flatten"     { return FLATTEN; }
"Add"         { return ADD; }
"Concat"      { return CONCAT; }
"BatchNorm"   { return BATCHNORM; }
"LayerNorm"   { return LAYERNORM; }

 /* ========== PARAMETER KEYWORDS ========== */
"filters"     { return FILTERS; }
"kernel"      { return KERNEL; }
"activation"  { return ACTIVATION; }
"stride"      { return STRIDE; }
"padding"     { return PADDING; }
"pool"        { return POOL; }
"units"       { return UNITS; }

 /* ========== ACTIVATION FUNCTIONS ========== */
"relu"        { return RELU; }
"sigmoid"     { return SIGMOID; }
"tanh"        { return TANH; }
"softmax"     { return SOFTMAX; }
"linear"      { return LINEAR; }

 /* ========== NUMBERS ========== */
{INTEGER}     { 
    yylval.ival = atoi(yytext);
    return NUMBER; 
}
{FLOAT}       { 
    yylval.fval = atof(yytext);
    return FLOAT_NUM; 
}

 /* ========== IDENTIFIERS ========== */
{ID}          { 
    yylval.sval = strdup(yytext);
    return IDENTIFIER; 
}

 /* ========== STRING LITERALS ========== */
{STRING}      { 
    /* Remove quotes from string */
    int len = strlen(yytext) - 2;
    yylval.sval = (char*)malloc(len + 1);
    strncpy(yylval.sval, yytext + 1, len);
    yylval.sval[len] = '\0';
    return STRING_LIT; 
}

 /* ========== PUNCTUATION ========== */
"{"           { return LBRACE; }
"}"           { return RBRACE; }
"["           { return LBRACKET; }
"]"           { return RBRACKET; }
"("           { return LPAREN; }
")"           { return RPAREN; }
":"           { return COLON; }
","           { return COMMA; }
"="           { return ASSIGN; }

 /* ========== WHITESPACE & COMMENTS ========== */
{WS}+         { /* Ignore whitespace */ }
{NEWLINE}     { yycolumn = 1; }
{SLCOMMENT}   { /* Ignore single-line comments */ }

"/*"          { BEGIN(COMMENT); }
<COMMENT>"*/" { BEGIN(INITIAL); }
<COMMENT>\n   { yycolumn = 1; }
<COMMENT>.    { /* Ignore comment content */ }

 /* ========== ERROR HANDLING ========== */
.             {
    fprintf(stderr, "Line %d: Lexical error - unexpected character '%s'\n", 
            yylineno, yytext);
    return yytext[0];
}

%%
